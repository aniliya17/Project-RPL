        <mxCell id="leg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#000000;arcSize=4;" value="&lt;b&gt;KETERANGAN&lt;/b&gt;" vertex="1">
