          <mxGeometry height="35" width="205" x="80" y="795" as="geometry" />
        </mxCell>
        <mxCell id="leg3s" edge="1" parent="1" style="endArrow=none;html=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="35" y="855" as="sourcePoint" />
            <mxPoint x="70" y="855" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg3t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" value="Communication Path (Jalur Komunikasi)" vertex="1">
          <mxGeometry height="30" width="205" x="80" y="840" as="geometry" />
        </mxCell>
        <mxCell id="leg4s" edge="1" parent="1" style="endArrow=none;html=1;dashed=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="35" y="895" as="sourcePoint" />
            <mxPoint x="70" y="895" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg4t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" value="Komunikasi Eksternal / Pendukung" vertex="1">
          <mxGeometry height="30" width="205" x="80" y="880" as="geometry" />
        </mxCell>
        <mxCell id="desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#000000;arcSize=3;" value="&lt;b&gt;DESKRIPSI DEPLOYMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Pelanggan dan Admin mengakses sistem melalui Web Browser (PC/laptop/smartphone) lewat Internet menggunakan HTTPS (port 443).&lt;br&gt;2. Request diterima Web Server (Nginx) sebagai reverse proxy lalu diteruskan ke Application Server.&lt;br&gt;3. Application Server menjalankan aplikasi Pre-Order Mochi (Laravel/Node.js, MVC, REST API) dalam Docker Container pada port 8080.&lt;br&gt;4. Aplikasi terhubung ke Database Server (MySQL) untuk menyimpan data user, pesanan, rasa, resep, dan kapasitas harian (port 3306).&lt;br&gt;5. Bukti pembayaran (maks. 5 MB) disimpan pada File Storage Server melalui HTTPS/SFTP.&lt;br&gt;6. Database di-backup otomatis setiap hari ke Backup Server." vertex="1">
          <mxGeometry height="215" width="720" x="310" y="730" as="geometry" />
        </mxCell>
        <mxCell id="spec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#000000;arcSize=3;" value="&lt;b&gt;SPESIFIKASI NODE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Client Device&lt;/b&gt; : Laptop/PC/Smartphone dengan browser modern.&lt;br&gt;&lt;b&gt;Web Server&lt;/b&gt; : Nginx reverse proxy &amp;amp; static assets (Linux/Windows).&lt;br&gt;&lt;b&gt;Application Server&lt;/b&gt; : Aplikasi Laravel/Node.js dalam Docker.&lt;br&gt;&lt;b&gt;Database Server&lt;/b&gt; : MySQL/PostgreSQL penyimpanan data utama.&lt;br&gt;&lt;b&gt;File Storage Server&lt;/b&gt; : Penyimpanan file bukti pembayaran.&lt;br&gt;&lt;b&gt;Backup Server&lt;/b&gt; : Penyimpanan backup data harian." vertex="1">
          <mxGeometry height="215" width="510" x="1050" y="730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
